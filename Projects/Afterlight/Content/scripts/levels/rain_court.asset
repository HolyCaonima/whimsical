{"id":"89785caf09f9f50b3c27d3b1a9084c7c","name":"rain_court","version":1,"type":"Script","storage":"embedded","metadata":{}}
/* Map content lives in /Game/Maps/RainCourt. This script binds gameplay to persistent roles. */
var RainCourt = {
    bind : function() {
        var data = Engine.sceneData(), m = data.materials;
        var player = Engine.sceneObject('player'), dog = Engine.sceneObject('companion');
        var beacon = Engine.sceneObject('beacon'), door = Engine.sceneObject('door');
        var cache = Engine.sceneObject('cache');
        Engine.setPlayer(player);
        Locomotion.init(player);
        CameraRig.init(Engine.cameraState());
        Companion.init(dog, player);
        Interactions.register(beacon, 'Power console', {x : -6, y : 0, z : -1.7}, function() {
            var state = Engine.sceneData();
            state.power = !state.power;
            Engine.lightIntensity(Engine.sceneObject('cyanLight'), state.power ? 22 : 0);
            Engine.setMaterial(beacon, state.power ? m.brass : m.dark);
            var p = Engine.position(door);
            Engine.transform(door, {position:{x:p.x, y:state.power ? 1.3 : 4.3, z:p.z}, rotation:{w:1}});
            Engine.solid(door, state.power);
            Engine.setSceneData(state);
        });
        Interactions.register(cache, 'Supply cache', {x : 3, y : 0, z : 5.3}, function() {
            Engine.setMaterial(cache, m.cyan);
        });
        Engine.log('Rain Court loaded: animated Kiln and following dog Ash, dynamic RT lights.');
    }
};

function initialize() { RainCourt.bind(); }
