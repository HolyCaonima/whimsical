body { width: 100%; height: 100%; font-family: LatoLatin; font-size: 12px; color: #a8beb3; pointer-events: none; }
.panel { position: absolute; background-color: #0f1d1de8; padding: 14px; }
#brand { top: 18px; left: 18px; width: 324px; border-left: 3px #b8ab7a; }
.title { font-size: 28px; color: #ebe9d4; }
.subtitle { font-size: 11px; margin-bottom: 6px; }
#place { top: 105px; left: 18px; width: 216px; }
.heading { font-size: 25px; color: #eff0de; margin-bottom: 7px; }
.gold, #message { color: #dacf9f; }
#companion { left: 28px; bottom: 72px; width: 292px; height: 72px; border-left: 2px #b8ab7a; }
.portrait { display: inline-block; width: 42px; height: 57px; background-color: #25443d; color: #75dabb; font-size: 29px; text-align: center; line-height: 57px; }
.details { display: inline-block; margin-left: 14px; vertical-align: top; }
#state { font-size: 13px; color: #75dabb; }
#message { position: absolute; left: 28px; bottom: 45px; }
#hover { position: absolute; left: 40%; bottom: 86px; color: #b8ab7a; font-size: 14px; }
#help { position: absolute; bottom: 0px; left: 0px; right: 0px; height: 24px; padding-top: 8px; padding-left: 28px; background-color: #0c1718ee; font-size: 11px; }

/* Afterlight project character controls and local map. */
.interactive { pointer-events: auto; }
.mint { color: #75dabb; font-weight: bold; }
.hint { font-size: 11px; margin-top: 4px; }
#animation { left: 28px; top: 216px; width: 276px; border-left: 2px #b8ab7a; max-height: 38%; overflow: auto; }
#solver { margin-top: 8px; }
#animation.empty { display: none; }
.attribute { margin-top: 14px; }
.label { margin-bottom: 5px; color: #b8ab7a; }
button { display: inline-block; width: 28px; height: 28px; background-color: #25443d; color: #75dabb; text-align: center; vertical-align: middle; font-size: 18px; }
button:hover { background-color: #456e61; }
button:active { background-color: #648979; }
.value { display: inline-block; width: 202px; height: 28px; margin-left: 4px; margin-right: 4px; background-color: #25443d; text-align: center; vertical-align: middle; line-height: 28px; color: #eff0de; }
#minimap { right: 28px; top: 24px; width: 186px; height: 177px; border-top: 2px #b8ab7a; }
#map { position: relative; width: 186px; height: 154px; overflow: hidden; }
@media (max-width: 800px) { #minimap { display: none; } }
@media (max-width: 620px) { #animation { display: none; } }
@media (max-height: 450px) { #animation { display: none; } }
#map-player { position: absolute; width: 6px; height: 6px; background-color: #75dabb; }
