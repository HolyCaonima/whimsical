body { width: 100%; height: 100%; font-family: LatoLatin; font-size: 12px; color: #a8beb3; pointer-events: none; }
.panel { position: absolute; background-color: #0f1d1de8; padding: 14px; }
#brand { top: 18px; left: 18px; width: 324px; border-left: 3px #b8ab7a; }
.title { font-size: 28px; color: #ebe9d4; }
.subtitle { font-size: 11px; margin-bottom: 6px; }
#place { top: 105px; left: 18px; width: 216px; }
.heading { font-size: 25px; color: #eff0de; margin-bottom: 7px; }
.gold, #message { color: #dacf9f; }
#companion { left: 28px; bottom: 72px; width: 292px; height: 72px; border-left: 2px #b8ab7a; }
.portrait { display: inline-block; width: 42px; height: 57px; background-color: #25443d; color: #75dabb; font-size: 29px; text-align: center; line-height: 57px; }
.details { display: inline-block; margin-left: 14px; vertical-align: top; }
#state { font-size: 13px; color: #75dabb; }
#message { position: absolute; left: 28px; bottom: 45px; }
#hover { position: absolute; left: 40%; bottom: 86px; color: #b8ab7a; font-size: 14px; }
#help { position: absolute; bottom: 0px; left: 0px; right: 0px; height: 24px; padding-top: 8px; padding-left: 28px; background-color: #0c1718ee; font-size: 11px; }
