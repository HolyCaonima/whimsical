<rml><head><title>Constraint Lab</title><link type="text/rcss" href="lab.rcss"/></head>
<body>
  <div id="menubar"><span class="brand">C</span><b>Constraint Lab</b><div id="tabs"/><div id="doc-title"><span id="eyebrow">实验 01</span><span class="doc-sep">/</span><span id="title">绳索实验</span><span id="status-dot"/></div></div>
  <div id="toolbar">
    <button id="pause"><span id="pause-label">暂停</span><span class="hotkey">Space</span></button>
    <button id="step">单步<span class="hotkey">N</span></button>
    <button id="reset">重置<span class="hotkey">R</span></button>
    <span class="separator">|</span>
    <button id="kick">施加冲量<span class="hotkey">I</span></button>
    <span class="separator">|</span>
    <span id="actions"/>
  </div>
  <div id="outliner">
    <div class="tab">求解模型</div>
    <div class="tree-header"><span class="tree-icon-space"/><span class="tree-name">关系族</span><span class="tree-kind">类型</span><span class="tree-rows">实例</span></div>
    <div id="families"/>
    <div id="family-count" class="foot">—</div>
  </div>
  <div id="viewbar">
    <button id="camera">重置视角</button>
    <span class="view-sep"/>
    <span class="view-tool"><span class="view-name">柔顺度</span><button id="stiffness" class="view-value"><span id="stiffness-label">紧致</span></button></span>
    <span class="view-tool"><span class="view-name">求解策略</span><button id="mode" class="view-value">Hybrid</button></span>
    <div id="legend"/>
  </div>
  <div id="viewport"/>
  <div id="viewhint"><span id="equation">C(q) = ‖qᵢ − qⱼ‖ − L</span><span class="hint-sep">|</span><span id="sample-note">一条绳子 · 64 个节点</span><span class="hint-sep">|</span><span class="hint-keys" id="hint">中键旋转 · 滚轮缩放</span></div>
  <div id="sidebar">
    <div class="tab">实验详情</div>
    <div id="inspector"><div class="inspect-pad">
      <div class="component-section">
        <div class="component-title">实验</div>
        <div class="field-summary" id="subtitle">重力下垂 · 端点控制 · 球面碰撞</div>
        <div class="field"><div class="field-label">规模<span class="field-unit" id="size-label">条数</span></div><div class="field-control"><span id="sizes" class="segmented"/></div></div>
        <div class="metric"><span>求解变量</span><b id="population">64</b></div>
        <div class="metric odd"><span>关系实例</span><b id="relation-count">255</b></div>
      </div>
      <div class="component-section" id="panel"/>
      <div class="component-section">
        <div class="component-title">运行状态</div>
        <div class="metric"><span>Tick</span><b id="tick">0</b></div>
        <div class="metric odd"><span>模拟时间</span><b id="time">0.00 s</b></div>
        <div class="metric"><span>GPU 求解耗时</span><b id="gpu">0.00 ms</b></div>
        <div class="metric odd"><span>关系平均长度误差</span><b id="strain">0.0%</b></div>
        <div class="meter-track"><div id="meter"/></div>
        <div class="metric"><span>非有限 / 奇异</span><b id="diagnostics">0 / 0</b></div>
      </div>
    </div></div>
  </div>
  <div id="statusbar"><span id="notice">正在准备实验…</span><span id="footer-state">编译中</span><span id="status">编译中</span></div>
</body></rml>
