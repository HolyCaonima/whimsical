<rml><head><title>Constraint Lab</title><link type="text/rcss" href="lab.rcss"/></head>
<body>
  <div id="header"><div class="brand-mark">~</div><div class="brand">CONSTRAINT LAB<span>GPU Dynamics / 变量与关系实验室</span></div><div id="tabs"/><div id="status">COMPILING</div></div>
  <div id="viewport"><div class="view-heading"><div class="eyebrow" id="eyebrow">EXPERIMENT 01</div><div class="view-title" id="title">绳索实验</div><div class="view-subtitle" id="subtitle">重力下垂 · 端点控制 · 球面碰撞</div></div><button id="camera">重置视角</button><div id="formula"><div id="equation">C(q) = ‖qᵢ − qⱼ‖ − L</div><div id="sample-note">一条绳子 · 64 个节点</div></div><div class="legend" id="legend"/></div>
  <div id="sidebar">
    <div class="section"><div class="eyebrow">SOLVER POPULATION</div><div id="population">64</div><div class="muted">参与求解的变量 · <span id="size-label">条数</span></div><div id="sizes" class="sizes"/><div class="metric"><span>关系实例</span><b id="relation-count">255</b></div></div>
    <div class="section"><div class="section-title">运行控制</div><div class="buttons"><button id="pause" class="primary">暂停 / Space</button><button id="step">单步</button></div><div class="buttons"><button id="kick">推一下 / I</button><button id="reset">重置 / R</button></div><div id="actions"/></div>
    <div class="section" id="panel"/>
    <div class="section"><div class="section-title">求解设置</div><div class="buttons"><button id="stiffness">柔顺度 <b id="stiffness-label">紧致</b></button><button id="mode">Hybrid</button></div></div>
    <div class="section telemetry"><div class="section-title">已完成状态</div><div class="metric"><span>Tick</span><b id="tick">0</b></div><div class="metric"><span>模拟时间</span><b id="time">0.00 s</b></div><div class="metric"><span>GPU 求解耗时</span><b id="gpu">0.00 ms</b></div><div class="metric"><span>关系平均长度误差</span><b id="strain">0.0%</b></div><div class="meter-track"><div id="meter"/></div><div class="metric diagnostics"><span>非有限 / 奇异</span><b id="diagnostics">0 / 0</b></div></div>
  </div>
  <div id="footer"><div id="notice">正在准备实验…</div><div id="footer-state">编译中</div></div>
</body></rml>
