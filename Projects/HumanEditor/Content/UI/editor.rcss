body { width:100%; height:100%; margin:0; font-family:LatoLatin; font-size:13px; color:#c8c8c8; pointer-events:none; }
div,p,h2 { display:block; }
button,input,textarea,select { font-family:LatoLatin; font-size:13px; color:#d3d3d3; pointer-events:auto; }
button { display:inline-block; background-color:#363636; border:1px #111111; border-radius:3px; padding:5px 10px; margin-right:4px; vertical-align:middle; }
button:hover { background-color:#484848; color:#ffffff; }
button:active,button.active { background-color:#17649b; color:#ffffff; }
button:disabled { color:#696969; background-color:#292929; }
input,textarea,select { background-color:#171717; border:1px #414141; border-radius:3px; padding:5px; }
input:focus,textarea:focus { border-color:#3185be; }
textarea { display:block; width:94%; height:160px; margin:7px 0; }
select { height:28px; }
/* RmlUi needs explicit scrollbar thickness; auto width covers the scroll container. */
scrollbarvertical { width:12px; background-color:#1a1a1a; }
scrollbarhorizontal { height:12px; background-color:#1a1a1a; }
scrollbarvertical sliderbar { width:12px; min-height:24px; }
scrollbarhorizontal sliderbar { height:12px; min-width:24px; }
sliderbar { background-color:#555555; border-radius:3px; }
sliderbar:hover { background-color:#707070; }
sliderbar:active { background-color:#818181; }
scrollbarcorner { background-color:#1a1a1a; }
.panel { position:absolute; background-color:#232323; border:1px #101010; pointer-events:auto; overflow:hidden; }
.tab { background-color:#1a1a1a; height:28px; line-height:28px; padding-left:10px; font-weight:bold; border-bottom:1px #101010; }
.tab button { padding:0px 8px; margin-left:14px; font-size:11px; font-weight:normal; }
.pad { padding:12px; }
#place .pad { position:absolute; left:0; right:0; top:29px; bottom:0; overflow:auto; }
.muted { color:#898989; font-size:11px; }
.wide { display:block; width:90%; text-align:left; margin:5px 0; padding:7px 8px; }
#menubar { position:absolute; top:0; left:0; width:100%; height:34px; background-color:#141414; pointer-events:auto; }
.brand { display:inline-block; border:2px #868686; border-radius:17px; width:25px; height:25px; line-height:25px; text-align:center; margin:2px 12px 0 9px; font-size:19px; color:#eeeeee; }
#menubar b { margin-right:24px; }
#menubar button { background-color:#141414; border-width:0; padding:5px 12px; }
#menubar { z-index:100; }
#menubar button:hover { background-color:#303030; }
#menubar button.active { background-color:#3b5365; color:#e1effa; }
#menu-shield { display:none; position:absolute; left:0; top:34px; right:0; bottom:0; z-index:99; pointer-events:auto; }
#main-menu { display:none; position:absolute; width:254px; padding:4px; z-index:101; background-color:#292929; border:1px #535353; border-radius:4px; pointer-events:auto; }
#main-menu button { display:block; position:relative; box-sizing:border-box; width:254px; height:30px; margin:0; padding:0 10px; line-height:30px; border:0px; border-radius:2px; background-color:#292929; text-align:left; font-size:12px; }
#main-menu button:hover, #main-menu button:focus { background-color:#3b5365; color:#ffffff; }
#main-menu button:disabled { background-color:#292929; color:#696969; }
#main-menu button span { position:absolute; right:10px; top:0; color:#929292; font-size:11px; }
#main-menu button:disabled span { color:#606060; }
.menu-separator { height:1px; margin:4px 6px; background-color:#414141; }
#doc-title { position:absolute; right:14px; top:6px; height:22px; line-height:22px; padding:0 11px; background-color:#1c1c1c; border:1px #2c2c2c; border-radius:4px; white-space:nowrap; }
#project-label { color:#8a8a8a; font-size:11px; }
.doc-sep { color:#4d4d4d; margin:0 7px; }
#level-label { color:#eaeaea; font-size:12px; font-weight:bold; }
#dirty-dot { display:none; }
#dirty-dot.on { display:inline-block; width:6px; height:6px; margin-left:9px; border-radius:3px; background-color:#e0a33e; vertical-align:middle; }
#toolbar { position:absolute; left:0; top:34px; height:44px; width:100%; background-color:#252525; pointer-events:auto; padding-left:12px; }
#toolbar button { margin-top:8px; }.separator { margin:0 8px; color:#535353; }.play { color:#94c85b; }
#viewbar { position:absolute; background-color:#282828; pointer-events:auto; }
#viewbar button { padding:3px 8px; font-size:12px; margin-top:2px; }
#pick-info { display:none; }
#viewport { position:absolute; pointer-events:auto; }
#viewhint { position:absolute; background-color:#151515bb; color:#bdbdbd; line-height:26px; font-size:11px; text-align:center; }
#gizmo { position:absolute; display:none; pointer-events:none; }
#gizmo-mode { position:absolute; left:-66px; top:98px; width:132px; text-align:center; background-color:#141414b0; font-size:10px; padding:3px; }
.search { display:block; width:90%; margin:8px 3%; }
.tree-header { background-color:#303030; padding:4px 9px; font-size:11px; }.tree-header span { float:right; }
#tree { position:absolute; left:0; top:95px; bottom:27px; width:100%; overflow:auto; }
.tree-row { position:relative; display:block; height:24px; line-height:24px; white-space:nowrap; background-color:#242424; pointer-events:auto; }
.tree-row.odd { background-color:#202020; }.tree-row:hover { background-color:#353535; }.tree-row.selected { background-color:#305c7d; color:#ffffff; }
.tree-icon { color:#bcb397; margin-right:6px; }.tree-type { position:absolute; right:4px; top:0; width:70px; color:#909090; font-size:10px; }
.tree-row.disabled { color:#777777; }.fold { display:inline-block; width:15px; text-align:center; }
.foot { position:absolute; bottom:0; left:0; width:100%; height:25px; background-color:#303030; line-height:25px; padding-left:9px; font-size:11px; }
#inspector { position:absolute; top:72px; bottom:0; left:0; width:100%; overflow:auto; }
.inspect-pad { display:block; box-sizing:border-box; padding:8px; }
.empty { padding:30px 18px; color:#858585; text-align:center; line-height:22px; }
.subtle { font-size:11px; padding:3px 7px; }
.actor-summary { margin-bottom:12px; padding:2px 0 10px; border-bottom:1px #383838; }
.actor-name-row, .actor-actions, .actor-meta { display:flex; align-items:center; }
.actor-name-row input { flex:1; min-width:0; box-sizing:border-box; height:30px; padding:5px 8px; font-size:14px; }
.actor-name-row button { flex-shrink:0; height:30px; box-sizing:border-box; margin:0 0 0 6px; }
.actor-meta { justify-content:space-between; margin:6px 0 10px; font-size:10px; color:#858585; }
.actor-actions { justify-content:space-between; }
.actor-actions button { margin:0; }
.inspect-notice { padding:7px; margin-bottom:8px; background-color:#29333b; color:#adc2d2; font-size:11px; line-height:17px; }
.component-section { margin-bottom:10px; border:1px #373737; border-radius:3px; }
.component-title { display:flex; align-items:center; height:31px; padding:0 5px; background-color:#2e2e2e; }
.component-title button { box-sizing:border-box; height:23px; padding:0 5px; margin:0 0 0 3px; font-size:10px; background-color:#2e2e2e; border-color:#424242; line-height:21px; }
.component-title .component-toggle { flex:1; min-width:0; margin:0; padding:0 2px; height:30px; line-height:30px; border:0px; text-align:left; font-size:12px; font-weight:bold; }
.component-title .component-remove { color:#999999; border-color:#2e2e2e; }
.component-title .component-remove:hover { color:#efaaaa; background-color:#503232; }
.component-title .component-toggle:hover { color:#ffffff; background-color:#373737; }
.component-title .component-json-button:hover { background-color:#414141; }
.component-section.modified .component-title { border-left:2px #b89157; padding-left:3px; }
.field { display:flex; align-items:center; box-sizing:border-box; padding:4px 7px; min-height:34px; }
.field-label { width:34%; flex-shrink:0; box-sizing:border-box; padding-right:8px; font-size:11px; line-height:15px; color:#aaaaaa; }
.field-unit { display:block; color:#777f85; font-size:9px; line-height:13px; }
.field-control { flex:1; min-width:0; }
.field-control > input { width:100%; }
.field input { box-sizing:border-box; height:26px; min-width:0; padding:3px 6px; font-size:11px; line-height:18px; }
.field input.number { text-align:right; }
.field.modified .field-label { color:#d7b47a; }
.vector { display:flex; width:100%; }
.vector-axis { display:flex; flex:1; min-width:0; height:26px; box-sizing:border-box; align-items:center; margin-left:3px; background-color:#191919; border:1px #414141; border-radius:3px; }
.vector-axis.axis-0 { margin-left:0; }
.vector-axis > span { flex-shrink:0; width:14px; font-size:11px; line-height:18px; text-align:center; color:#c77f79; }
.vector-axis.axis-1 > span { color:#8cbd87; }
.vector-axis.axis-2 > span { color:#7ea7cf; }
.vector-axis.axis-3 > span { color:#b5a0cb; }
.vector-axis input { flex:1; width:0; min-width:0; height:24px; padding:3px 5px 3px 0; border:0px; border-radius:0px; background-color:#191919; text-align:right; }
.vector-axis input:focus { background-color:#273b49; }
.bool-toggle { display:inline-flex; align-items:center; box-sizing:border-box; height:26px; padding:0 7px; margin:0; border:0px; background-color:#292929; font-size:11px; color:#949494; }
.toggle-mark { display:inline-block; box-sizing:border-box; width:12px; height:12px; margin-right:7px; border:1px #686868; border-radius:2px; background-color:#191919; }
.bool-toggle.on { color:#c2d7e6; background-color:#293740; }
.bool-toggle.on .toggle-mark { background-color:#6399be; border:3px #344f62; }
.bool-toggle:hover { background-color:#384a57; }
.property-group { margin:3px 7px 5px; border-left:1px #444444; }
.property-group-toggle { display:block; width:100%; box-sizing:border-box; height:25px; padding:0 7px; margin:0; line-height:25px; background-color:#292929; border:0px; text-align:left; font-size:11px; color:#aebac3; }
.property-group .field { padding-right:0; }
.parent-link { display:block; width:100%; height:26px; box-sizing:border-box; padding:3px 6px; margin:0; text-align:left; overflow:hidden; font-size:11px; color:#9cbed6; }
.asset-reference { position:relative; display:block; box-sizing:border-box; width:100%; height:26px; margin:0; padding:3px 24px 3px 6px; text-align:left; overflow:hidden; white-space:nowrap; font-size:11px; line-height:18px; color:#9cbed6; }
.asset-choose { position:absolute; right:6px; top:3px; pointer-events:none; }
#detail-asset-picker { position:absolute; box-sizing:border-box; padding:8px; background-color:#252525; border:1px #586771; border-radius:4px; pointer-events:auto; }
#asset-picker-search { display:block; box-sizing:border-box; width:100%; height:30px; padding:5px 7px; margin:0 0 6px; font-size:12px; line-height:18px; }
#asset-picker-results { overflow:hidden; }
.asset-picker-item { display:block; box-sizing:border-box; width:100%; height:42px; margin:0; padding:4px 8px; border:0px; border-radius:2px; background-color:#252525; text-align:left; }
.asset-picker-item:hover { background-color:#374b58; }
.asset-picker-item.active { background-color:#305c7d; }
.asset-picker-name { display:block; font-size:12px; line-height:18px; white-space:nowrap; overflow:hidden; }
.asset-picker-item.current .asset-picker-name { color:#a9d8f4; }
.asset-picker-path { display:block; font-size:10px; line-height:15px; color:#929fa8; white-space:nowrap; overflow:hidden; }
.asset-picker-empty { padding:16px 8px; font-size:12px; color:#929292; }
#asset-picker-count { height:18px; margin-top:6px; font-size:10px; line-height:18px; color:#929fa8; }
.field-summary, .component-empty { font-size:11px; color:#8d8d8d; line-height:16px; }
.component-empty { padding:10px 7px; }
.component-actions { display:none; align-items:center; justify-content:flex-end; padding:7px; border-top:1px #3c3c3c; background-color:#282724; }
.component-actions span { flex:1; min-width:0; font-size:10px; color:#c7ab7e; }
.component-actions button { box-sizing:border-box; height:25px; margin:0 0 0 5px; padding:0 8px; line-height:23px; font-size:11px; }
.component-actions button.primary { background-color:#356b92; border-color:#477fa6; color:#ffffff; }
.component-actions button.primary:hover { background-color:#417ea9; }
.component-error { color:#e6a285; font-size:11px; line-height:17px; padding:0 7px; }
.derived { padding:8px; font-size:10px; line-height:17px; color:#858585; }
#selection-count { float:right; margin-right:10px; font-size:10px; color:#8d8d8d; }
.browserbar { height:36px; padding:6px 10px 0; background-color:#282828; }.browserbar button { font-size:11px; padding:4px 8px; }
#breadcrumb { position:absolute; left:310px; right:8px; top:37px; height:28px; overflow:auto; white-space:nowrap; font-size:12px; }
#sources { position:absolute; top:73px; bottom:26px; left:0; width:220px; background-color:#202020; border-right:1px #111111; }
.sources-title { height:23px; padding-left:10px; line-height:23px; font-size:11px; color:#a4a4a4; }
.source-search { height:30px; padding-left:8px; }
.source-search span { display:inline-block; width:28px; font-size:11px; color:#929292; vertical-align:middle; }
#folder-search { width:163px; padding:3px; vertical-align:middle; }
#folders { position:absolute; top:55px; bottom:0; left:0; width:220px; overflow:auto; }
.folder { display:block; width:204px; height:25px; box-sizing:border-box; padding:3px 6px; pointer-events:auto; white-space:nowrap; overflow:hidden; }.folder:hover { background-color:#363636; }.folder.active { background-color:#345369; }
.folder-fold { display:inline-block; width:14px; text-align:center; color:#a4a4a4; vertical-align:middle; }
.folder-label { vertical-align:middle; margin-left:6px; }
.folder-glyph { position:relative; display:inline-block; width:15px; height:14px; vertical-align:middle; }
.folder-tab { position:absolute; left:1px; top:1px; width:7px; height:5px; background-color:#ac8e51; border-radius:2px; }
.folder-front { position:absolute; left:0; top:4px; width:15px; height:10px; background-color:#c4a361; border-radius:2px; }
#asset-area { position:absolute; left:232px; right:8px; top:76px; bottom:28px; }
#asset-controls { display:flex; align-items:center; height:30px; }
#asset-controls input, #asset-controls select { box-sizing:border-box; height:30px; font-size:12px; border-radius:4px; }
.asset-search-field { display:flex; flex:1; align-items:center; min-width:100px; margin-right:12px; }
.asset-search-field span { width:46px; flex-shrink:0; font-size:11px; color:#929292; }
#asset-search { flex:1; min-width:0; padding:6px 10px; background-color:#1b1b1b; border-color:#393939; }
#asset-controls select { flex-shrink:0; padding:0; background-color:#2b2b2b; border-color:#454545; margin-right:8px; }
#asset-filter { width:148px; }
#asset-sort { width:128px; }
#asset-controls select:hover { background-color:#333333; border-color:#656565; }
#asset-controls select:focus { border-color:#5986a6; }
#asset-controls selectvalue { height:28px; line-height:28px; padding-left:10px; }
#asset-controls selectarrow { width:0; height:0; margin:12px 10px 0 8px; border-top:5px #aaaaaa; border-left:4px transparent; border-right:4px transparent; }
#asset-controls selectbox { box-sizing:border-box; width:100%; margin-top:5px; margin-bottom:5px; padding:4px; background-color:#292929; border:1px #535353; border-radius:4px; }
#asset-controls option { display:block; height:28px; line-height:28px; padding:0 8px; font-size:12px; color:#c8c8c8; border-radius:2px; }
#asset-controls option:checked { background-color:#304b60; color:#e0effa; }
#asset-controls option:hover { background-color:#414141; color:#ffffff; }
.asset-view-toggle { display:flex; flex-shrink:0; box-sizing:border-box; height:30px; padding:2px; background-color:#191919; border:1px #414141; border-radius:4px; }
.asset-view-toggle button { width:45px; height:24px; box-sizing:border-box; padding:0; margin:0; border:0px; border-radius:2px; background-color:#191919; color:#929292; font-size:11px; line-height:24px; text-align:center; }
.asset-view-toggle button:hover { background-color:#333333; color:#eeeeee; }
.asset-view-toggle button.active { background-color:#3b5365; color:#e1effa; }
#assets { position:absolute; left:0; top:40px; bottom:0; width:100%; overflow:auto; }
#asset-area.compact #asset-controls { flex-wrap:wrap; height:66px; }
#asset-area.compact .asset-search-field { flex:0 0 100%; margin-right:0; margin-bottom:6px; }
#asset-area.compact #assets { top:76px; }
#asset-grid { display:flex; flex-wrap:wrap; align-content:flex-start; align-items:flex-start; }
.asset { display:block; flex-shrink:0; width:112px; height:112px; margin:3px 6px 7px 0; background-color:#303030; border:1px #141414; border-radius:3px; pointer-events:auto; }
.asset:hover,.asset.selected { background-color:#394c5c; border-color:#4b83a8; }
.asset-icon { margin:6px; height:53px; background-color:#222a30; text-align:center; line-height:53px; font-size:26px; color:#99aec0; border-bottom:3px #bc9850; }
.asset-name { padding:0px 6px; font-size:11px; height:28px; overflow:hidden; }.asset-type { color:#898989; font-size:9px; padding:3px 6px; }
.asset-path { display:none; }
#assets.list-view #asset-grid { flex-direction:column; flex-wrap:nowrap; }
.browser-footer { position:absolute; left:0; right:0; bottom:0; height:25px; padding-left:9px; background-color:#292929; font-size:11px; line-height:25px; }
#asset-location { position:absolute; left:42%; right:10px; height:25px; overflow:hidden; text-align:right; white-space:nowrap; color:#898989; }
.folder-card .asset-icon { background-color:#282724; border-bottom-width:0; }
.folder-card .folder-glyph { width:62px; height:44px; margin-top:3px; }
.folder-card .folder-tab { width:27px; height:12px; top:2px; left:3px; border-radius:3px; }
.folder-card .folder-front { width:62px; height:34px; top:10px; border-radius:3px; }
.folder-card .asset-type { color:#bb9e65; }
.list-view .asset { position:relative; display:block; box-sizing:border-box; height:33px; margin:0 0 2px; border-radius:0px; }
.list-view .asset-icon { position:absolute; left:7px; top:4px; margin:0; padding:0; width:24px; height:23px; line-height:23px; font-size:15px; border-bottom:0px; background-color:#303030; }
.list-view .asset-name { position:absolute; left:35px; top:6px; width:37%; height:20px; line-height:20px; font-size:12px; padding:0; }
.list-view .asset-type { position:absolute; left:44%; top:6px; width:14%; height:20px; line-height:20px; font-size:11px; padding:0; }
.list-view .asset-path { display:block; position:absolute; left:60%; right:8px; top:6px; height:20px; line-height:20px; font-size:11px; color:#898989; overflow:hidden; white-space:nowrap; }
.list-view .folder-glyph { width:19px; height:16px; margin:0; }
.list-view .folder-tab { width:9px; height:6px; top:1px; left:1px; }
.list-view .folder-front { width:19px; height:13px; top:4px; }
#log-panel { display:none; }#log-text { width:96%; height:76%; margin:8px; font-size:12px; }
#statusbar { position:absolute; left:0; bottom:0; height:26px; width:100%; background-color:#252525; border-top:1px #111111; line-height:26px; font-size:11px; }
#status { margin-left:12px; }#save-state { position:absolute; right:16px; top:0; color:#a3bba1; }
#place-search { width:90%; margin-bottom:9px; padding:4px; }
.search-label { color:#929292; font-size:11px; margin-bottom:5px; width:180px; white-space:nowrap; }
.searchbar { display:block; height:37px; padding:5px 9px 0; }
.searchbar span { display:inline-block; width:15%; color:#929292; font-size:11px; vertical-align:middle; }
.searchbar input { width:77%; padding:4px; vertical-align:middle; }
#place-categories { margin-bottom:10px; }
#place-categories button { padding:4px 7px; }
.place-icon { display:inline-block; width:25px; color:#b8c6d0; font-size:17px; }
.splitter { position:absolute; pointer-events:auto; background-color:#101010; }
.splitter:hover { background-color:#3983b8; }
#breadcrumb button { background-color:#282828; border-width:0; margin-right:0; padding:3px 4px; }
#breadcrumb button:hover { background-color:#414141; }
.type-Material { border-bottom-color:#67ae71; }.type-Script { border-bottom-color:#659ada; }.type-Texture { border-bottom-color:#bf7777; }.type-Mesh { border-bottom-color:#8faac0; }
#statusbar { pointer-events:auto; }
#statusbar button { font-size:11px; padding:2px 9px; margin:0; height:19px; border-top:0px; border-bottom:0px; }
#status { position:absolute; left:125px; top:0; width:65%; height:25px; overflow:hidden; white-space:nowrap; }
#viewbar { overflow:hidden; white-space:nowrap; }
#viewbar button { padding:3px 6px; margin-right:2px; }
#viewbar #maximize-view { position:absolute; right:4px; top:2px; width:26px; height:24px; box-sizing:border-box; margin:0; padding:0; }
.viewport-icon { position:absolute; left:6px; top:5px; width:12px; height:12px; pointer-events:none; }
.viewport-icon .corner { position:absolute; width:4px; height:4px; box-sizing:border-box; border-color:#d3d3d3; pointer-events:none; }
.viewport-icon .tl { left:0; top:0; border-left:2px #d3d3d3; border-top:2px #d3d3d3; }
.viewport-icon .tr { right:0; top:0; border-right:2px #d3d3d3; border-top:2px #d3d3d3; }
.viewport-icon .bl { left:0; bottom:0; border-left:2px #d3d3d3; border-bottom:2px #d3d3d3; }
.viewport-icon .br { right:0; bottom:0; border-right:2px #d3d3d3; border-bottom:2px #d3d3d3; }
#maximize-view.restored .tl { border:0px; border-right:2px #d3d3d3; border-bottom:2px #d3d3d3; }
#maximize-view.restored .tr { border:0px; border-left:2px #d3d3d3; border-bottom:2px #d3d3d3; }
#maximize-view.restored .bl { border:0px; border-right:2px #d3d3d3; border-top:2px #d3d3d3; }
#maximize-view.restored .br { border:0px; border-left:2px #d3d3d3; border-top:2px #d3d3d3; }
.tree-row { width:100%; box-sizing:border-box; overflow:hidden; padding-right:76px; }
.tree-type { background-color:#242424; height:24px; }.tree-row.selected .tree-type { background-color:#305c7d; }
#context-overlay { pointer-events:auto; }
#actor-menu { position:absolute; width:246px; padding:4px; background-color:#252525; border:1px #555555; pointer-events:auto; }
#actor-menu button { position:relative; display:block; box-sizing:border-box; width:246px; height:29px; margin:0; padding:5px 10px; border-width:0; border-radius:0px; background-color:#252525; text-align:left; }
#actor-menu button:hover { background-color:#305c7d; }
#actor-menu button:disabled { background-color:#252525; color:#696969; }
#actor-menu button span { position:absolute; right:10px; top:6px; color:#909090; font-size:11px; }
.context-separator { width:238px; height:1px; margin:4px; background-color:#414141; }
#dialog.project-dialog { width:560px; padding:24px; margin-left:-305px; top:22%; border-color:#4b4b4b; border-radius:6px; }
#dialog.project-dialog h2 { font-size:21px; margin-bottom:8px; }
#dialog.project-dialog .project-intro { color:#999999; margin:0 0 24px; font-size:12px; }
.project-file-label { font-size:10px; letter-spacing:1px; color:#999999; margin-bottom:8px; }
.project-file-row { display:flex; align-items:center; width:560px; }
#dialog.project-dialog #project-file { flex:1; min-width:0; box-sizing:border-box; height:34px; margin:0 8px 0 0; padding:8px 10px; font-size:12px; color:#c0c0c0; background-color:#1b1b1b; border-color:#414141; }
#project-browse { flex-shrink:0; height:34px; box-sizing:border-box; padding:0 14px; margin:0; line-height:32px; text-align:center; border:1px #555555; background-color:#363636; }
#project-browse:hover { background-color:#454545; }
#project-preview { display:flex; align-items:center; margin-top:20px; padding:16px; background-color:#20252a; border:1px #35434f; border-radius:4px; }
.project-badge { width:40px; height:40px; line-height:40px; text-align:center; flex-shrink:0; font-size:22px; color:#b1cadb; background-color:#344b5c; border-radius:5px; }
.project-summary { flex:1; min-width:0; margin-left:14px; }
#project-name { font-size:16px; color:#e0e0e0; margin-bottom:5px; }
#project-map { font-size:11px; color:#9ca9b2; }
#dialog.project-dialog .project-note { font-size:11px; color:#929292; margin:14px 0 0; }
#dialog.project-dialog #dialog-error { font-size:11px; }
#dialog.project-dialog #dialog-actions { display:flex; justify-content:flex-end; margin-top:24px; padding-top:16px; border-top:1px #3b3b3b; }
#dialog.project-dialog #dialog-actions button { height:34px; box-sizing:border-box; padding:0 16px; margin:0 0 0 8px; line-height:32px; text-align:center; }
#dialog.project-dialog button.primary { background-color:#356b92; border-color:#477fa6; color:#ffffff; }
#dialog.project-dialog button.primary:hover { background-color:#417ea9; }
#dialog.project-dialog button.primary:disabled { background-color:#303030; border-color:#3c3c3c; color:#777777; }
