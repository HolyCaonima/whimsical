<rml><head><title>HumanEditor</title><link type="text/rcss" href="editor.rcss"/></head>
<body id="editor">
  <div id="menubar"><span class="brand">H</span><b>HumanEditor</b><button id="file-menu">File</button><button id="edit-menu">Edit</button><button id="window-menu">Window</button><button id="help">Help</button><div id="doc-title"><span id="project-label">No project</span><span class="doc-sep">/</span><span id="level-label">Untitled</span><span id="dirty-dot"/></div></div>
  <div id="toolbar"><button id="open-content">Open Project</button><button id="new-level">New Level</button><button id="save">Save</button><button id="save-as">Save As</button><span class="separator">|</span><button id="undo">Undo</button><button id="redo">Redo</button><span class="separator">|</span><button id="play" class="play">Play</button><button id="pause">Pause</button><button id="stop">Stop</button><button id="world-settings">World Settings</button></div>
  <div id="place" class="panel"><div class="tab">Place Actors</div><div class="pad"><div class="search-label">Search actors</div><input id="place-search" type="text" placeholder="Search actors..."/><div id="place-categories"/><div id="palette"/></div></div>
  <div id="viewbar">
    <button id="camera-reset" title="Reset to the map camera">Perspective</button>
    <button id="space" title="Move and rotate in world or local axes">World</button>
    <span class="view-sep"/>
    <span class="view-tool">
      <button id="snap-move" class="view-toggle active" title="Grid snap">Grid</button>
      <button id="snap-move-value" class="view-value" title="Grid snap increment">0.25 m</button>
    </span>
    <span class="view-tool">
      <button id="snap-rotate" class="view-toggle active" title="Rotation snap">Rotate</button>
      <button id="snap-rotate-value" class="view-value" title="Rotation snap increment">10°</button>
    </span>
    <span class="view-tool">
      <button id="snap-scale" class="view-toggle active" title="Scale snap">Scale</button>
      <button id="snap-scale-value" class="view-value" title="Scale snap increment">0.1</button>
    </span>
    <button id="camera-speed" class="view-speed" title="Camera speed">Speed <span id="camera-speed-label">1x</span></button>
    <button id="maximize-view" title="Maximize viewport"><span class="viewport-icon"><span class="corner tl"/><span class="corner tr"/><span class="corner bl"/><span class="corner br"/></span></button>
    <span id="pick-info"/>
  </div>
  <div id="viewport"/>
  <div id="viewhint">W Move / E Rotate / R Scale   |   RMB + WASD fly   |   MMB pan   |   Wheel zoom   |   Ctrl+click multi-select</div>
  <div id="gizmo" class="move"><div id="gizmo-mode"/></div>
  <div id="outliner" class="panel"><div class="tab">World Outliner</div><div class="searchbar"><span>Search</span><input id="tree-search" type="text"/></div><div class="tree-header">Actor label <span>Component</span></div><div id="tree"/><div id="actor-count" class="foot"/></div>
  <div id="details" class="panel"><div class="tab">Details <span id="selection-count"/></div><div class="searchbar"><span>Filter</span><input id="details-search" type="text" placeholder="Search properties..."/></div><div id="inspector"/></div>
  <div id="content" class="panel">
    <div class="tab">Content Browser <button id="show-log">Output Log</button></div>
    <div class="browserbar"><button id="asset-back">Back</button><button id="asset-forward">Forward</button><button id="asset-up">Up</button><button id="rescan">Refresh</button><button id="asset-new">+ New asset</button><span id="breadcrumb"/></div>
    <div id="sources"><div class="sources-title">Folders</div><div class="source-search"><span>Find</span><input id="folder-search" type="text"/></div><div id="folders"/></div>
    <div id="asset-area"><div id="asset-controls"><div class="asset-search-field"><span>Search</span><input id="asset-search" type="text"/></div><select id="asset-filter"><option value="All">All categories</option><option value="Map">Levels</option><option value="Material">Materials</option><option value="Mesh">Meshes</option><option value="Texture">Textures</option><option value="Script">Scripts</option><option value="Asset">Other</option></select><select id="asset-sort"><option value="asc">Name A-Z</option><option value="desc">Name Z-A</option></select><div class="asset-view-toggle"><button id="asset-tiles" class="active">Tiles</button><button id="asset-list">List</button></div></div><div id="assets"><div id="asset-grid"/></div></div>
    <div class="browser-footer"><span id="asset-count"/><span id="asset-location"/></div>
  </div>
  <div id="log-panel" class="panel"><div class="tab">Output Log <button id="hide-log">Content Browser</button></div><textarea id="log-text"/></div>
  <div id="split-left" class="splitter"/><div id="split-right" class="splitter"/><div id="split-bottom" class="splitter horizontal"/><div id="split-details" class="splitter horizontal"/>
  <div id="statusbar"><button id="content-drawer">Content Drawer</button><span id="status">Ready</span><span id="save-state">All saved</span></div>
  <div id="menu-shield"/><div id="main-menu"/>
</body></rml>
