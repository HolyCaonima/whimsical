<rml><head><title>HumanEditor</title><link type="text/rcss" href="editor.rcss"/></head>
<body id="editor">
  <div id="menubar"><span class="brand">H</span><b>HumanEditor</b><button id="file-menu">File</button><button id="edit-menu">Edit</button><button id="window-menu">Window</button><button id="help">Help</button><span id="project-label">ENGINE EDITOR</span></div>
  <div id="toolbar"><button id="open-content">Open Content</button><button id="new-level">New Level</button><button id="save">Save</button><button id="save-as">Save As</button><span class="separator">|</span><button id="undo">Undo</button><button id="redo">Redo</button><span class="separator">|</span><button id="play" class="play">&#9654; Play</button><button id="pause">Pause</button><button id="stop">Stop</button><button id="world-settings">World Settings</button><span id="level-label">Workbench</span></div>
  <div id="place" class="panel"><div class="tab">Place Actors</div><div class="pad"><div class="muted">BASIC</div><div id="palette"/><div class="section-title">Selection</div><button id="duplicate" class="wide">Duplicate</button><button id="delete" class="wide">Delete</button><button id="focus" class="wide">Focus selected</button><button id="enable" class="wide">Toggle enabled</button><button id="parent" class="wide">Set parent</button><button id="unparent" class="wide">Detach from parent</button><div class="section-title">Transform</div><button id="space" class="wide">World coordinates</button><button id="snap" class="wide">Snap: 0.25 m / 10 deg</button><div class="hint">W Move  /  E Rotate  /  R Scale<br/>F Focus  /  Del Delete<br/>Ctrl+D Duplicate<br/>Ctrl+Z / Y Undo / Redo</div></div></div>
  <div id="viewbar"><button id="tool-move" class="active">Move</button><button id="tool-rotate">Rotate</button><button id="tool-scale">Scale</button><button id="camera-reset">Perspective</button><span class="muted">Lit</span><span id="pick-info">Entity ID picking</span></div>
  <div id="viewport"/>
  <div id="viewhint">RMB orbit + WASD fly   |   MMB pan   |   Wheel zoom   |   Ctrl+click multi-select</div>
  <div id="gizmo"><div id="gizmo-mode">MOVE / world</div><div id="line-x" class="axis-line x"/><div id="line-y" class="axis-line y"/><div id="line-z" class="axis-line z"/><button id="axis-x" class="axis x">X</button><button id="axis-y" class="axis y">Y</button><button id="axis-z" class="axis z">Z</button></div>
  <div id="outliner" class="panel"><div class="tab">World Outliner</div><input id="tree-search" class="search" type="text" placeholder="Search actors..."/><div class="tree-header">Actor label <span>Component</span></div><div id="tree"/><div id="actor-count" class="foot"/></div>
  <div id="details" class="panel"><div class="tab">Details <span id="selection-count"/></div><div id="inspector"/></div>
  <div id="content" class="panel"><div class="tab">Content Browser <button id="show-log">Output Log</button></div><div class="browserbar"><button id="rescan">Refresh</button><button id="asset-up">Up</button><button id="asset-new">New asset</button><span id="breadcrumb"/></div><div id="folders"/><div id="asset-area"><input id="asset-search" type="text" placeholder="Search assets..."/><div id="assets"/></div></div>
  <div id="log-panel" class="panel"><div class="tab">Output Log <button id="hide-log">Content Browser</button></div><textarea id="log-text"/></div>
  <div id="statusbar"><span id="status">Ready</span><span id="save-state">All saved</span></div>
</body></rml>
