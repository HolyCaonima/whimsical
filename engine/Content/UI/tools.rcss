body { font-family: LatoLatin; font-size: 13px; color: #a8beb3; width: 100%; height: 100%; pointer-events: none; }
.panel { position: absolute; background-color: #0f1d1de8; padding: 12px; }
#stats { right: 28px; bottom: 48px; width: 218px; }
#fps { font-size: 25px; color: #75dabb; margin-top: 5px; margin-bottom: 5px; }
#timing, #present { font-size: 11px; line-height: 18px; }
#present { color: #b8ab7a; }
#physics-label { display: none; margin-top: 12px; font-size: 10px; }
#physics-label.enabled { display: block; }
