#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#define COMPUTE_PASS
#define SURFACE_PASS
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
void mergeDI(inout DIReservoir r, DIReservoir other, Surface s, float cap) {
    if (other.stats.w == 0)
        return;
    float m = min(other.stats.y, cap), target = diTarget(s, other.sampleLight);
    diAdd(r, other.sampleLight, target * other.stats.x * m, m, target);
}
void mergeGI(inout GIReservoir r, GIReservoir other, Surface s, vec3 source, float cap) {
    if (other.stats.w == 0)
        return;
    float jacobian = 1;
    if (other.normalKind.w > 0) {
        vec3 oldVector = source - other.positionDistance.xyz, newVector = s.p - other.positionDistance.xyz;
        float oldD2 = dot(oldVector, oldVector), newD2 = dot(newVector, newVector);
        float oldCos = abs(dot(other.normalKind.xyz, safeNormalize(oldVector))),
              newCos = abs(dot(other.normalKind.xyz, safeNormalize(newVector)));
        jacobian = newCos * oldD2 / max(oldCos * newD2, 1e-6);
        if (jacobian < .1 || jacobian > 10)
            return;
    }
    float target = giTarget(s, other), m = min(other.stats.y, cap);
    // Reconnection visibility is evaluated at the destination, preventing spatial light leaks.
    vec3 end = other.normalKind.w < 0 ? s.p + other.positionDistance.xyz * 150 : other.positionDistance.xyz;
    bool valid;
    if (other.normalKind.w > 0) {
        Surface hit;
        float hitDistance;
        valid = traceSurface(s.p + s.n * .012, safeNormalize(end - s.p), hit, hitDistance);
        valid = valid && hit.id == uint(other.normalKind.w + .5) && distance(hit.p, end) < .06 &&
                dot(hit.n, other.normalKind.xyz) > .9;
    } else
        valid = visible(s.p, s.n, end);
    if (!valid) {
        r.stats.y += m;
        return;
    }
    giAdd(r, other, target * other.stats.x * m * jacobian, m, target);
}
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (!inBounds(pixel))
        return;
    uint index = indexOf(pixel);
    rng = hash(index + g.counts.z * 97531u + 931u);
    Surface s = surfaceAt(pixel);
    DIReservoir di;
    di.sampleLight = vec4(0);
    di.stats = vec4(0);
    GIReservoir gi;
    gi.positionDistance = gi.normalKind = gi.radiancePdf = gi.stats = vec4(0);
    if (s.id == 0) {
        currentDI[index] = di;
        currentGI[index] = gi;
        return;
    }
    mergeDI(di, candidateDI[index], s, 8);
    mergeGI(gi, candidateGI[index], s, s.p, 1);
    ivec2 prev = ivec2(floor(vec2(pixel) + vec2(.5) + imageLoad(gMotion, pixel).xy * g.resolution.xy));
    if (g.counts.w != 0 && inBounds(prev)) {
        vec4 oldP = imageLoad(previousPosition, prev), oldN = imageLoad(previousNormal, prev);
        float expectedDepth = imageLoad(gMotion, pixel).z;
        float actualDepth = (g.previousViewProjection * vec4(oldP.xyz, 1)).w;
        if (uint(oldP.w + .5) == s.id && dot(s.n, safeNormalize(oldN.xyz)) > .92 &&
            abs(expectedDepth - actualDepth) < max(.08, .01 * expectedDepth)) {
            mergeDI(di, previousDI[indexOf(prev)], s, 24);
            mergeGI(gi, previousGI[indexOf(prev)], s, oldP.xyz, 8);
        }
    }
    for (int k = 0; k < 4; k++) {
        float angle = random() * 2 * PI, radius = 2 + random() * 12;
        ivec2 other = pixel + ivec2(round(vec2(cos(angle), sin(angle)) * radius));
        if (!inBounds(other))
            continue;
        Surface n = surfaceAt(other);
        if (n.id == 0 || dot(n.n, s.n) < .92 || distance(n.p, s.p) > 1.3 ||
            abs(n.roughness - s.roughness) > .2)
            continue;
        mergeDI(di, candidateDI[indexOf(other)], s, 8);
        mergeGI(gi, candidateGI[indexOf(other)], s, n.p, 1);
    }
    diFinalize(di);
    giFinalize(gi);
    currentDI[index] = di;
    currentGI[index] = gi;
}
