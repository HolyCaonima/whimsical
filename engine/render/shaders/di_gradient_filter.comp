#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#define COMPUTE_PASS
#include "common.glsl"
layout(local_size_x=8,local_size_y=8) in;
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p,imageSize(diGradient)))) return;
    ivec2 center=min(p*3+1,ivec2(g.resolution.xy)-1);
    vec3 n=safeNormalize(imageLoad(previousNormal,center).xyz);
    float z=imageLoad(previousViewZ,center).x;
    vec4 sum=vec4(0);
    float weights=0;
    // Filter in the 1/3-resolution domain, not 25 taps per full-resolution pixel.
    for (int y=-2;y<=2;++y) for (int x=-2;x<=2;++x) {
        ivec2 q=p+ivec2(x,y);
        if (any(lessThan(q,ivec2(0))) || any(greaterThanEqual(q,imageSize(diGradient)))) continue;
        ivec2 samplePixel=min(q*3+1,ivec2(g.resolution.xy)-1);
        vec3 other=safeNormalize(imageLoad(previousNormal,samplePixel).xyz);
        float otherZ=imageLoad(previousViewZ,samplePixel).x;
        float w=exp(-.5*float(x*x+y*y))*pow(max(dot(n,other),0),16)*
                exp(-abs(z-otherZ)/max(.01,.02*z));
        sum+=imageLoad(diGradient,q)*w;
        weights+=w;
    }
    imageStore(filteredDiGradient,p,weights>0 ? sum/weights : vec4(0));
}
