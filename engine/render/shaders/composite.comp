#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#define COMPUTE_PASS
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
vec3 aces(vec3 c) {
    return clamp((c * (2.51 * c + .03)) / (c * (2.43 * c + .59) + .14), 0, 1);
}
vec4 outlineColor(uint entity) {
    uint lo = 0, hi = outlineCount.x;
    while (lo < hi) {
        uint mid = lo + (hi - lo) / 2;
        if (outlines[mid].identity.x < entity) lo = mid + 1;
        else hi = mid;
    }
    return lo < outlineCount.x && outlines[lo].identity.x == entity ? outlines[lo].color : vec4(0);
}
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (!inBounds(p))
        return;
    Surface s = surfaceAt(p);
    vec2 uv = (vec2(p) + .5) / g.resolution.xy;
    vec3 color;
    if (s.id == 0) {
        vec4 world = g.inverseViewProjection * vec4(uv * 2 - 1, 1, 1);
        color = sky(normalize(world.xyz / world.w - g.eyeTime.xyz)) * .32;
    } else
        color = imageLoad(denoisedDiffuse, p).rgb * s.albedo * (1 - s.metallic) +
                imageLoad(denoisedSpecular, p).rgb * specularMaterialFactor(s) + s.emission;
    int debug = int(g.resolution.z);
    if (debug == 1)
        color = s.albedo;
    if (debug == 2)
        color = s.n * .5 + .5;
    if (debug == 3)
        color = vec3(imageLoad(gViewZ, p).r / 50);
    if (debug == 4)
        color = imageLoad(directDebug, p).rgb;
    if (debug == 5)
        color = imageLoad(indirectDebug, p).rgb;
    if (debug == 6)
        color = imageLoad(rawDiffuse, p).rgb * s.albedo * (1 - s.metallic) +
                imageLoad(rawSpecular, p).rgb * specularMaterialFactor(s) + s.emission;
    if (debug == 7)
        color = vec3(.5) + vec3(imageLoad(gMotion, p).xy * 15, 0);
    if (debug == 0 || debug == 4 || debug == 5 || debug == 6)
        color = pow(aces(max(color, vec3(0)) * g.renderSettings.x), vec3(1 / 2.2));
    if (debug == 0 && s.id != 0) {
        float fog = 1 - exp(-length(g.eyeTime.xyz - s.p) * .007);
        color = mix(color, vec3(.12, .17, .18), fog * .4);
    }
    // Explicit presentation requests; geometry IDs carry no gameplay meaning.
    if (debug == 0 && outlineCount.x > 0) {
        for (int i = 0; i < 4; i++) {
            ivec2 q = clamp(p + ivec2(i == 0   ? 1
                                      : i == 1 ? -1
                                               : 0,
                                      i == 2   ? 1
                                      : i == 3 ? -1
                                               : 0),
                            ivec2(0), ivec2(g.resolution.xy) - 1);
            uint id = uint(imageLoad(gPosition, q).w + .5);
            if (id != 0 && s.id != id) {
                vec4 outline = outlineColor(id);
                if (outline.a > 0) {
                    color = mix(color, outline.rgb, outline.a);
                    break;
                }
            }
        }
    }
    color *= 1 - .18 * pow(length((uv - .5) * 1.2), 2);
    imageStore(finalImage, p, vec4(color, 1));
}
